{
  "rules": {
    "sentence": {
      ".read": true,
      "question": {
        ".write": false
      },
      "threshold": {
        ".read": true,
        ".write": false
      },
      "words": {
        ".read": true,
        "$wordId": {
          ".write": "auth != null && newData.child('text').exists() && newData.child('timestamp').exists() && newData.child('authorCount').exists()"
        }
      },
      "candidates": {
        ".read": true,
        ".write": "auth != null",
        "$word": {
          ".write": "auth != null && newData.child('voters').child(auth.uid).exists() && (!data.exists() || !data.child('voters').child(auth.uid).exists()) && newData.child('count').exists()"
        }
      },
      "publishState": {
        ".read": true,
        ".write": "auth != null && (!newData.exists() || (newData.child('word').exists() && newData.child('timestamp').exists()))"
      }
    }
  }
}
